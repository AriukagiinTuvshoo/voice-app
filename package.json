{
  "name": "voice-app",
  "version": "1.2.0",
  "description": "VOICE Desktop — Монгол хэлний яриа таних, зөв бичих дүрэм (spellcheck.mn), VoiceStudio AI ба Windows шууд бичих систем",
  "private": true,
  "main": "server.cjs",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
