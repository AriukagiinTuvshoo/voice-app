  "dependencies": {
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "electron": "^40.8.0",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.6",
    "typescript": "5.7.3"
  }
}
