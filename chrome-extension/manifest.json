{
  "manifest_version": 3,
  "name": "VOICE — Монгол Яриаг Текст Болгогч (Local)",
  "version": "1.2.0",
  "description": "Facebook, Google, YouTube, Messenger зэрэг бүх сайт дээр 1 товшилтоор эсвэл F8 товчоор шууд ярьж бичих өргөтгөл (100% Local).",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VOICE Dictation"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
