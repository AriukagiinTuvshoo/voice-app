{
  "manifest_version": 3,
  "name": "VOICE — Монгол Яриаг Текст Болгогч",
  "version": "1.0.0",
  "description": "Google хайлт, Facebook, YouTube, Messenger зэрэг бүх сайт дээр дуу хоолойгоороо шууд бичих хөтчийн өргөтгөл.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://voice-app.onrender.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VOICE Dictation"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Ярьж бичихийг эхлүүлэх / зогсоох (Alt+Shift+V)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
